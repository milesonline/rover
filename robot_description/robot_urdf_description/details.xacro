<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ================================================= -->
    <!-- REAR EQUIPMENT BOX                               -->
    <!-- ================================================= -->

    <link name="rear_equipment_box">

        <visual>
            <geometry>
                <box size="0.55 0.65 0.25"/>
            </geometry>

            <material name="equipment_material">
                <color rgba="0.20 0.21 0.22 1"/>
            </material>
        </visual>

        <collision>
            <geometry>
                <box size="0.55 0.65 0.25"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="2.0"/>
            <inertia
                ixx="0.1"
                ixy="0"
                ixz="0"
                iyy="0.1"
                iyz="0"
                izz="0.1"/>
        </inertial>

    </link>

    <joint name="rear_equipment_box_joint" type="fixed">

        <parent link="base_link"/>
        <child link="rear_equipment_box"/>

        <origin xyz="-0.48 0 0.58"/>

    </joint>


    <!-- ================================================= -->
    <!-- ANTENNA MAST                                     -->
    <!-- ================================================= -->

    <link name="antenna">

        <visual>
            <origin xyz="0 0 0.20"/>
            <geometry>
                <cylinder radius="0.025" length="0.40"/>
            </geometry>

            <material name="antenna_material">
                <color rgba="0.12 0.13 0.14 1"/>
            </material>
        </visual>

    </link>

    <joint name="antenna_joint" type="fixed">

        <parent link="base_link"/>
        <child link="antenna"/>

        <origin xyz="0.55 -0.38 0.50"/>

    </joint>


    <!-- ================================================= -->
    <!-- ANTENNA TIP                                      -->
    <!-- ================================================= -->

    <link name="antenna_tip">

        <visual>
            <geometry>
                <sphere radius="0.055"/>
            </geometry>

            <material name="antenna_tip_material">
                <color rgba="0.25 0.26 0.27 1"/>
            </material>
        </visual>

    </link>

    <joint name="antenna_tip_joint" type="fixed">

        <parent link="antenna"/>
        <child link="antenna_tip"/>

        <origin xyz="0 0 0.42"/>

    </joint>


    <!-- ================================================= -->
    <!-- FRONT PROTECTION BAR                              -->
    <!-- ================================================= -->

    <link name="front_bumper">

        <visual>
            <geometry>
                <box size="0.10 0.95 0.16"/>
            </geometry>

            <material name="bumper_material">
                <color rgba="0.25 0.26 0.27 1"/>
            </material>
        </visual>

        <collision>
            <geometry>
                <box size="0.10 0.95 0.16"/>
            </geometry>
        </collision>

    </link>

    <joint name="front_bumper_joint" type="fixed">

        <parent link="base_link"/>
        <child link="front_bumper"/>

        <origin xyz="0.83 0 0.30"/>

    </joint>

</robot>
