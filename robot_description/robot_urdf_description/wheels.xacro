<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ================================================= -->
    <!-- WHEEL PROPERTIES                                  -->
    <!-- ================================================= -->

    <xacro:property name="wheel_radius" value="0.25"/>
    <xacro:property name="wheel_width" value="0.15"/>
    <xacro:property name="wheel_mass" value="2.0"/>


    <!-- ================================================= -->
    <!-- WHEEL MACRO                                       -->
    <!-- ================================================= -->

    <xacro:macro name="wheel" params="name x y">

        <link name="${name}">

            <!-- Tire -->
            <visual>

                <origin rpy="1.5708 0 0"/>

                <geometry>
                    <cylinder
                        radius="${wheel_radius}"
                        length="${wheel_width}"/>
                </geometry>

                <material name="wheel_material">
                    <color rgba="0.08 0.08 0.08 1"/>
                </material>

            </visual>


            <!-- Tire collision -->
            <collision>

                <origin rpy="1.5708 0 0"/>

                <geometry>
                    <cylinder
                        radius="${wheel_radius}"
                        length="${wheel_width}"/>
                </geometry>

            </collision>


            <!-- Wheel mass -->
            <inertial>

                <mass value="${wheel_mass}"/>

                <inertia
                    ixx="0.035"
                    ixy="0.0"
                    ixz="0.0"
                    iyy="0.0625"
                    iyz="0.0"
                    izz="0.035"/>

            </inertial>

        </link>


        <!-- Wheel axle -->
        <joint
            name="${name}_joint"
            type="continuous">

            <parent link="base_link"/>
            <child link="${name}"/>

            <origin
                xyz="${x} ${y} 0"
                rpy="0 0 0"/>

            <axis xyz="0 1 0"/>

        </joint>

    </xacro:macro>


    <!-- ================================================= -->
    <!-- SIX WHEELS                                        -->
    <!-- ================================================= -->

    <!-- LEFT -->
    <xacro:wheel
        name="front_left_wheel"
        x="0.55"
        y="0.62"/>

    <xacro:wheel
        name="middle_left_wheel"
        x="0.0"
        y="0.62"/>

    <xacro:wheel
        name="rear_left_wheel"
        x="-0.55"
        y="0.62"/>


    <!-- RIGHT -->
    <xacro:wheel
        name="front_right_wheel"
        x="0.55"
        y="-0.62"/>

    <xacro:wheel
        name="middle_right_wheel"
        x="0.0"
        y="-0.62"/>

    <xacro:wheel
        name="rear_right_wheel"
        x="-0.55"
        y="-0.62"/>


    <!-- ================================================= -->
    <!-- ROCKER-BOGIE VISUAL STRUCTURE                    -->
    <!-- ================================================= -->


    <!-- ================================================= -->
    <!-- LEFT ROCKER                                      -->
    <!-- ================================================= -->

    <link name="left_rocker">

        <visual>

            <!-- Long arm running toward front wheel -->
            <origin
                xyz="0.25 0 0.02"
                rpy="0 -0.08 0"/>

            <geometry>
                <box size="0.65 0.14 0.16"/>
            </geometry>

            <material name="suspension_material">
                <color rgba="0.28 0.29 0.30 1"/>
            </material>

        </visual>

    </link>


    <joint name="left_rocker_joint" type="fixed">

        <parent link="base_link"/>
        <child link="left_rocker"/>

        <origin
            xyz="0 0.62 0.18"
            rpy="0 0 0"/>

    </joint>


    <!-- ================================================= -->
    <!-- RIGHT ROCKER                                     -->
    <!-- ================================================= -->

    <link name="right_rocker">

        <visual>

            <origin
                xyz="0.25 0 0.02"
                rpy="0 -0.08 0"/>

            <geometry>
                <box size="0.65 0.14 0.16"/>
            </geometry>

            <material name="suspension_material"/>

        </visual>

    </link>


    <joint name="right_rocker_joint" type="fixed">

        <parent link="base_link"/>
        <child link="right_rocker"/>

        <origin
            xyz="0 -0.62 0.18"
            rpy="0 0 0"/>

    </joint>


    <!-- ================================================= -->
    <!-- LEFT BOGIE                                       -->
    <!-- ================================================= -->

    <link name="left_bogie">

        <visual>

            <!-- Arm running from middle toward rear -->
            <origin
                xyz="-0.27 0 -0.05"
                rpy="0 0.15 0"/>

            <geometry>
                <box size="0.70 0.14 0.16"/>
            </geometry>

            <material name="suspension_material"/>

        </visual>

    </link>


    <joint name="left_bogie_joint" type="fixed">

        <parent link="base_link"/>
        <child link="left_bogie"/>

        <origin
            xyz="0 0.62 0.12"
            rpy="0 0 0"/>

    </joint>


    <!-- ================================================= -->
    <!-- RIGHT BOGIE                                      -->
    <!-- ================================================= -->

    <link name="right_bogie">

        <visual>

            <origin
                xyz="-0.27 0 -0.05"
                rpy="0 0.15 0"/>

            <geometry>
                <box size="0.70 0.14 0.16"/>
            </geometry>

            <material name="suspension_material"/>

        </visual>

    </link>


    <joint name="right_bogie_joint" type="fixed">

        <parent link="base_link"/>
        <child link="right_bogie"/>

        <origin
            xyz="0 -0.62 0.12"
            rpy="0 0 0"/>

    </joint>


    <!-- ================================================= -->
    <!-- FRONT SUSPENSION MOUNTS                          -->
    <!-- ================================================= -->

    <link name="front_left_mount">

        <visual>

            <origin xyz="0 0 0.02"/>

            <geometry>
                <box size="0.14 0.18 0.30"/>
            </geometry>

            <material name="suspension_material"/>

        </visual>

    </link>

    <joint name="front_left_mount_joint" type="fixed">

        <parent link="base_link"/>
        <child link="front_left_mount"/>

        <origin
            xyz="0.55 0.62 0.02"
            rpy="0 0 0"/>

    </joint>


    <link name="front_right_mount">

        <visual>

            <origin xyz="0 0 0.02"/>

            <geometry>
                <box size="0.14 0.18 0.30"/>
            </geometry>

            <material name="suspension_material"/>

        </visual>

    </link>

    <joint name="front_right_mount_joint" type="fixed">

        <parent link="base_link"/>
        <child link="front_right_mount"/>

        <origin
            xyz="0.55 -0.62 0.02"
            rpy="0 0 0"/>

    </joint>


    <!-- ================================================= -->
    <!-- REAR SUSPENSION MOUNTS                           -->
    <!-- ================================================= -->

    <link name="rear_left_mount">

        <visual>

            <origin xyz="0 0 0.02"/>

            <geometry>
                <box size="0.14 0.18 0.30"/>
            </geometry>

            <material name="suspension_material"/>

        </visual>

    </link>

    <joint name="rear_left_mount_joint" type="fixed">

        <parent link="base_link"/>
        <child link="rear_left_mount"/>

        <origin
            xyz="-0.55 0.62 0.02"
            rpy="0 0 0"/>

    </joint>


    <link name="rear_right_mount">

        <visual>

            <origin xyz="0 0 0.02"/>

            <geometry>
                <box size="0.14 0.18 0.30"/>
            </geometry>

            <material name="suspension_material"/>

        </visual>

    </link>

    <joint name="rear_right_mount_joint" type="fixed">

        <parent link="base_link"/>
        <child link="rear_right_mount"/>

        <origin
            xyz="-0.55 -0.62 0.02"
            rpy="0 0 0"/>

    </joint>


    <!-- ================================================= -->
    <!-- WHEEL HUBS                                       -->
    <!-- ================================================= -->

    <xacro:macro name="wheel_hub" params="name x y">

        <link name="${name}_hub">

            <visual>

                <origin rpy="1.5708 0 0"/>

                <geometry>
                    <cylinder
                        radius="0.11"
                        length="0.18"/>
                </geometry>

                <material name="hub_material">
                    <color rgba="0.35 0.36 0.37 1"/>
                </material>

            </visual>

        </link>


        <joint name="${name}_hub_joint" type="fixed">

            <parent link="base_link"/>
            <child link="${name}_hub"/>

            <origin
                xyz="${x} ${y} 0"
                rpy="0 0 0"/>

        </joint>

    </xacro:macro>


    <!-- Hubs -->
    <xacro:wheel_hub name="front_left_wheel" x="0.55" y="0.62"/>
    <xacro:wheel_hub name="middle_left_wheel" x="0.0" y="0.62"/>
    <xacro:wheel_hub name="rear_left_wheel" x="-0.55" y="0.62"/>

    <xacro:wheel_hub name="front_right_wheel" x="0.55" y="-0.62"/>
    <xacro:wheel_hub name="middle_right_wheel" x="0.0" y="-0.62"/>
    <xacro:wheel_hub name="rear_right_wheel" x="-0.55" y="-0.62"/>

</robot>