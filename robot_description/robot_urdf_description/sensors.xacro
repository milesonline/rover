<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="sensor_mass" value="1.0"/>

    <link name="sensor_mast">

        <visual>
            <origin xyz="0 0 0.25"/>
            <geometry>
                <cylinder radius="0.08" length="0.5"/>
            </geometry>
        </visual>

        <collision>
            <origin xyz="0 0 0.25"/>
            <geometry>
                <cylinder radius="0.08" length="0.5"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0.25"/>
            <mass value="${sensor_mass}"/>
            <inertia
                ixx="0.02"
                ixy="0.0"
                ixz="0.0"
                iyy="0.02"
                iyz="0.0"
                izz="0.02"/>
        </inertial>

    </link>

    <joint name="sensor_mast_joint" type="fixed">

        <parent link="base_link"/>
        <child link="sensor_mast"/>

        <origin xyz="0 0 0.15"/>

    </joint>

</robot>