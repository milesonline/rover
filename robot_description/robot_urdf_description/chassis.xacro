<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Chassis dimensions -->
    <xacro:property name="chassis_length" value="1.5"/>
    <xacro:property name="chassis_width"  value="1.0"/>
    <xacro:property name="chassis_height" value="0.3"/>

    <!-- Chassis mass -->
    <xacro:property name="chassis_mass" value="20.0"/>

    <link name="base_link">

        <visual>
            <geometry>
                <box size="${chassis_length}
                           ${chassis_width}
                           ${chassis_height}"/>
            </geometry>
        </visual>

        <collision>
            <geometry>
                <box size="${chassis_length}
                           ${chassis_width}
                           ${chassis_height}"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="${chassis_mass}"/>

            <inertia
                ixx="1.0"
                ixy="0.0"
                ixz="0.0"
                iyy="1.0"
                iyz="0.0"
                izz="1.0"/>
        </inertial>

    </link>

</robot>