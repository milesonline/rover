<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Main chassis dimensions -->
    <xacro:property name="chassis_length" value="1.6"/>
    <xacro:property name="chassis_width" value="1.1"/>
    <xacro:property name="chassis_height" value="0.30"/>
    <xacro:property name="chassis_z" value="0.35"/>
    <xacro:property name="chassis_mass" value="20.0"/>

    <!-- Main body -->
    <link name="base_link">

        <visual>
            <origin xyz="0 0 ${chassis_z}"/>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>

            <material name="chassis_material">
                <color rgba="0.18 0.20 0.22 1"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 ${chassis_z}"/>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 ${chassis_z}"/>
            <mass value="${chassis_mass}"/>

            <inertia
                ixx="2.167"
                ixy="0.0"
                ixz="0.0"
                iyy="4.417"
                iyz="0.0"
                izz="6.283"/>
        </inertial>

    </link>


    <!-- Raised central equipment deck -->
    <link name="equipment_deck">

        <visual>
            <origin xyz="0 0 0.12"/>
            <geometry>
                <box size="1.15 0.80 0.18"/>
            </geometry>

            <material name="deck_material">
                <color rgba="0.25 0.27 0.29 1"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0.12"/>
            <geometry>
                <box size="1.15 0.80 0.18"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0.12"/>
            <mass value="4.0"/>

            <inertia
                ixx="0.2"
                ixy="0.0"
                ixz="0.0"
                iyy="0.2"
                iyz="0.0"
                izz="0.2"/>
        </inertial>

    </link>

    <joint name="equipment_deck_joint" type="fixed">

        <parent link="base_link"/>
        <child link="equipment_deck"/>

        <origin xyz="0 0 ${chassis_z + chassis_height/2}"/>

    </joint>

</robot>