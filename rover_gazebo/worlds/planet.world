<?xml version="1.0" ?>

<sdf version="1.9">
    <world name="planet">

        <plugin
            filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>

        <plugin
            filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>

        <plugin
            filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>

        <plugin
            filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

        <!-- ========================= -->
        <!-- WORLD                      -->
        <!-- ========================= -->

        <gravity>0 0 -3.71</gravity>

        <scene>
            <ambient>0.7 0.7 0.7 1</ambient>
            <background>0.45 0.50 0.55 1</background>
        </scene>


        <!-- ========================= -->
        <!-- SUN                        -->
        <!-- ========================= -->

        <light name="sun" type="directional">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 20 0 0 0</pose>

            <diffuse>1 1 1 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>

            <direction>-0.5 0.5 -1</direction>
        </light>


        <!-- ========================= -->
        <!-- PLANET SURFACE             -->
        <!-- ========================= -->

        <model name="ground">
            <static>true</static>

            <link name="ground_link">

                <collision name="ground_collision">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>
                </collision>

                <visual name="ground_visual">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>

                    <material>
                        <ambient>0.45 0.32 0.20 1</ambient>
                        <diffuse>0.65 0.48 0.30 1</diffuse>
                        <specular>0.05 0.05 0.05 1</specular>
                    </material>
                </visual>

            </link>
        </model>


        <!-- ========================= -->
        <!-- MOUNTAIN                   -->
        <!-- ========================= -->

        <model name="mountain">
            <static>true</static>
            <pose>8 5 3 0 0 0</pose>

            <link name="mountain_link">

                <collision name="mountain_collision">
                    <geometry>
                        <cone>
                            <radius>4</radius>
                            <length>6</length>
                        </cone>
                    </geometry>
                </collision>

                <visual name="mountain_visual">
                    <geometry>
                        <cone>
                            <radius>4</radius>
                            <length>6</length>
                        </cone>
                    </geometry>

                    <material>
                        <ambient>0.35 0.22 0.12 1</ambient>
                        <diffuse>0.55 0.35 0.20 1</diffuse>
                        <specular>0.05 0.05 0.05 1</specular>
                    </material>
                </visual>

            </link>
        </model>


        <!-- ========================= -->
        <!-- HILL                       -->
        <!-- ========================= -->

        <model name="hill">
            <static>true</static>
            <pose>-8 6 2 0 0.15 0</pose>

            <link name="hill_link">

                <collision name="hill_collision">
                    <geometry>
                        <cylinder>
                            <radius>4</radius>
                            <length>4</length>
                        </cylinder>
                    </geometry>
                </collision>

                <visual name="hill_visual">
                    <geometry>
                        <cylinder>
                            <radius>4</radius>
                            <length>4</length>
                        </cylinder>
                    </geometry>

                    <material>
                        <ambient>0.30 0.25 0.20 1</ambient>
                        <diffuse>0.50 0.42 0.32 1</diffuse>
                        <specular>0.05 0.05 0.05 1</specular>
                    </material>
                </visual>

            </link>
        </model>


        <!-- ========================= -->
        <!-- RAMP                       -->
        <!-- ========================= -->

        <model name="ramp">
            <static>true</static>
            <pose>0 8 1 0 0.25 0</pose>

            <link name="ramp_link">

                <collision name="ramp_collision">
                    <geometry>
                        <box>
                            <size>6 4 2</size>
                        </box>
                    </geometry>
                </collision>

                <visual name="ramp_visual">
                    <geometry>
                        <box>
                            <size>6 4 2</size>
                        </box>
                    </geometry>

                    <material>
                        <ambient>0.40 0.35 0.30 1</ambient>
                        <diffuse>0.60 0.52 0.42 1</diffuse>
                        <specular>0.05 0.05 0.05 1</specular>
                    </material>
                </visual>

            </link>
        </model>


        <!-- ========================= -->
        <!-- ROCK 1                     -->
        <!-- ========================= -->

        <model name="rock_1">
            <static>true</static>
            <pose>4 -5 1 0 0 0</pose>

            <link name="rock_1_link">

                <collision name="rock_1_collision">
                    <geometry>
                        <sphere>
                            <radius>1</radius>
                        </sphere>
                    </geometry>
                </collision>

                <visual name="rock_1_visual">
                    <geometry>
                        <sphere>
                            <radius>1</radius>
                        </sphere>
                    </geometry>

                    <material>
                        <ambient>0.30 0.30 0.30 1</ambient>
                        <diffuse>0.50 0.50 0.50 1</diffuse>
                        <specular>0.05 0.05 0.05 1</specular>
                    </material>
                </visual>

            </link>
        </model>


        <!-- ========================= -->
        <!-- ROCK 2                     -->
        <!-- ========================= -->

        <model name="rock_2">
            <static>true</static>
            <pose>-3 -6 0.75 0 0 0</pose>

            <link name="rock_2_link">

                <collision name="rock_2_collision">
                    <geometry>
                        <sphere>
                            <radius>0.75</radius>
                        </sphere>
                    </geometry>
                </collision>

                <visual name="rock_2_visual">
                    <geometry>
                        <sphere>
                            <radius>0.75</radius>
                        </sphere>
                    </geometry>

                    <material>
                        <ambient>0.28 0.28 0.28 1</ambient>
                        <diffuse>0.45 0.45 0.45 1</diffuse>
                        <specular>0.05 0.05 0.05 1</specular>
                    </material>
                </visual>

            </link>
        </model>


        <!-- ========================= -->
        <!-- ROCK 3                     -->
        <!-- ========================= -->

        <model name="rock_3">
            <static>true</static>
            <pose>12 -2 1.25 0 0 0</pose>

            <link name="rock_3_link">

                <collision name="rock_3_collision">
                    <geometry>
                        <sphere>
                            <radius>1.25</radius>
                        </sphere>
                    </geometry>
                </collision>

                <visual name="rock_3_visual">
                    <geometry>
                        <sphere>
                            <radius>1.25</radius>
                        </sphere>
                    </geometry>

                    <material>
                        <ambient>0.25 0.25 0.25 1</ambient>
                        <diffuse>0.42 0.42 0.42 1</diffuse>
                        <specular>0.05 0.05 0.05 1</specular>
                    </material>
                </visual>

            </link>
        </model>

    </world>
</sdf>